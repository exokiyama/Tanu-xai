{
  "name": "tanu-xai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch Tanu/index.ts",
    "build": "tsc",
    "start": "node index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/smoke.mjs && node test/db-fallback.mjs && node test/command-audit.mjs",
    "lint": "find Tanu db lib plugins -type f -name '*.ts' -print0 | xargs -0 eslint"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.4.2",
    "node-cache": "^5.1.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "description": "A production-ready, stable, and modular WhatsApp bot built with Node.js, TypeScript, and Baileys."
}
